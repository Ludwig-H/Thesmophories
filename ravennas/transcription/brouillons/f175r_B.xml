<page folio="175r" image="26_f175r_classense177r_vv1044-1081.jpg" vers="1045-1081">
  <lignes>
    <!-- Lecture B. Passe 1 (lettres) : état provisoire, diacritiques et marques à reprendre aux passes 2 et 3. -->
    <l n="1">επι δε τοισ δε το δ αν επεμψεν</l>
    <l n="2">ιερον ενθα γυναικεσ</l>
    <l n="3">ιω μοι μοι ρασ αν ετι κτε δαιμων</l>
    <l n="4">ω καταρατοσ εγω τι σ εμον ου κ επεψεται</l>
    <l n="5">παθοσ αμεγαρτον επι κακων παρουσια</l>
    <l n="6">ειθε με πυρ φοροσ αιθεροσ αστηρ</l>
    <l n="7">τον βαρβαρον εξολεσειεν</l>
    <l n="8">ου γαρ ετ αθαναταν φλογα λευσειν</l>
    <l n="9">εστιν εμοι φιλον ωσ εκρεμασθην</l>
    <l n="10">λαιμο τμη τ αχη δια μενων αιολαν</l>
    <l n="11">νεκυσιν επι πορειαν</l>
    <l n="12">χαιρ ω φιλη παι τον δε πατερα κηφεα</l>
    <l n="13">οσ σ εξεθηκεν απολεσειαν οι θεοι</l>
    <l n="14">συ δ ει τισ ητισ τον εμον ωκτειρασ παθοσ</l>
    <l n="15">ηχω λογων αντωδοσ επικοκκαστρεια</l>
    <l n="16">ηπερ περυσιν εν τω δε ταυτω ι χωριω ι</l>
    <l n="17">ευριπιδη ι και αυτη ξυνηγωνιζομην</l>
    <l n="18">αλλ ω τεκνον σε μεν τοσαυτησ χρη ποειν</l>
    <l n="19">κλαιειν ελεινωσ σε δ επικλαιειν υστερον</l>
    <l n="20">εμοι μελησει ταυτα γ αλλ αρχου λογων</l>
    <l n="21">ω νυξ ιερα</l>
    <l n="22">ωσ μακρον ιππευμα διωκεισ</l>
    <l n="23">αστεροειδεα νωτα διφρεου</l>
    <l n="24">σ αιθεροσ ιερασ</l>
    <l n="25">του σεμνοτατου διολυμπου</l>
    <l n="26">διολυμπου</l>
    <l n="27">τι ποτ ανδρομεδα περι αλλα κακων</l>
    <l n="28">μεροσ εξ ελεγχων ελαχον</l>
    <l n="29">μεροσ εξελαχον</l>
    <l n="30">θανατου τλημων</l>
    <l n="31">θανατου τλημων</l>
    <l n="32">απολεισ μ ω γραυσ στωμυλλωμενη</l>
    <l n="33">στωμυλωμενη</l>
    <l n="34">νη δια οχληρα γ εισηρρηκασ</l>
    <l n="35">λιαν</l>
    <l n="36">λιαν</l>
    <l n="37">ω γαθ εασον με μονωδησαι</l>
    <l n="38">και χαριει μοι</l>
    <l n="39">παυσαι παυσαι</l>
    <l n="40">βαλλ εσ κορακασ βαλλ εσ κορακασ</l>
    <l n="41">τι το κακον τι το κακον</l>
    <l n="42">ληρεισ ληρεισ</l>
    <l n="43">οιμωζε οιμωζε</l>
  </lignes>
