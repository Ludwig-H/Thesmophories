    <sch n="9" ancre="15" place="mg-d" main="R2">— ἐπεὶ εἰσήγαγεν κακοστένακ<abbr dev="ον">τ̀</abbr><lb/>τὴν ἠχὼ ὁ <abbr dev="ίδης">εὐρι<hi rend="sus">π</hi></abbr> ἐν τῆ ἀνδρομέδα<lb/>εἰσ τοῦτο παίζει ἐζήλ<unclear cert="moyenne">ωσεν</unclear> <abbr signe="ϗ" dev="καὶ"/> αὐτὸ πτο<lb coupe="oui"/>λεμαῖοσ ὁ φιλοπάτωρ <unclear cert="moyenne">ἐν</unclear> ἧ<unclear cert="moyenne">ι</unclear> πεποί<lb coupe="oui"/>ηκε τραγωδίαι ἀδων<unclear cert="moyenne">ι</unclear>δι περὶ ἧσ ὁ<lb/>ἐρώμεν<hi rend="sus">ο</hi> αὐτῶ<unclear cert="moyenne">ι</unclear> ἀγαθοκλ<hi rend="sus">σ</hi> <unclear cert="moyenne">γε</unclear>γραφεν<lb/>ὁ ἀδελφὸσ τησ ερωμένησ αὐτοῦ πάλιν<lb/>ἀγαθοκλείασ ÷</sch>
    <sch n="10" ancre="19" place="mg-g" main="R2">ἠρέμα ὁ <abbr dev="ής">κηδεστ<hi rend="sus">σ</hi></abbr><lb/><abbr dev="ῦτο">τ<hi rend="sus">υ</hi>το</abbr> πρὸσ <abbr dev="όν">τ̀</abbr> <abbr dev="ίδην">εὐρι<hi rend="sus">π</hi></abbr></sch>
