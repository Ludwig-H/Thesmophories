<page folio="f174r" image="24_f174r_classense176r_vv0959-1000.jpg" vers="959-1001">
  <lignes/>
  <scholies>
    <sch n="1" ancre="10" place="mg-g" main="R2">οτι εν <abbr signe="~" dev="ω">θεάτρ</abbr><lb/>ησαν ÷</sch>
    <sch n="2" ancre="10" place="mg-d" main="R2">ἐπειδὴ μέλλουσιν ἐλθεῖν εἰσ τὴν<lb/>ὠδήν ÷</sch>
    <sch n="3" ancre="11" place="mg-g" main="R2">— τὸν ἀπόλλωνα ÷</sch>
    <sch n="4" ancre="13" place="mg-g" main="R2">— τὴν παρθένον ÷</sch>
    <sch n="5" ancre="15" place="mg-d" main="R2">ηρα τελεία <abbr signe="ϗ" dev="καὶ"/> ζευσ τέλειοσ ἐτιμῶντο ἐν τοῖσ γάμοισ ὡσ<lb/>πρυτανεισ ὄντεσ τῶν γάμων τέλοσ <abbr signe="ʒ" dev="δὲ"/> ὁ γάμοσ διὸ <abbr signe="ϗ" dev="καὶ"/> προ<lb coupe="oui"/>τέλεια εκαλεῖτο ἡ θυσία ἡ προ τῶν γάμων γινομένη ÷</sch>
    <sch n="6" ancre="19" place="mg-d" main="R2">ἔφοροσ γὰρ τῶν θρεμμάτων ὁ <abbr signe="¯" dev="ός">θε</abbr> ÷</sch>
    <sch n="7" ancre="28" place="mg-d" main="R2">τορῶσ <abbr signe="ϗ" dev="καὶ"/> τρανῶσ λέγε την ὠδήν ÷</sch>
    <sch n="8" ancre="43" place="mg-d" main="R2">— <abbr dev="ὶ">αν<hi rend="sus">τ</hi></abbr> προσ τὴν αἰθρίαν βαρβαριζ<unclear cert="moyenne">ει</unclear> <unclear cert="moyenne"><abbr signe="ʒ" dev="δὲ"/></unclear><lb/>ὁ τοξότησ ÷</sch>
  </scholies>
  <notes>
    <note>Brouillon : confrontation avec Rutherford et Dübner en cours.</note>
  </notes>
</page>
