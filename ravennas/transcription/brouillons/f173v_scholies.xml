  <lignes/>
  <scholies>
    <sch n="1" ancre="2" place="mg-d" main="R2">οὐ κυρίωσ ἀλλ <abbr signe="\" dev="ον">οι</abbr><lb/>κενοβουλοσ ÷</sch>
    <sch n="2" ancre="3" place="mg-g" main="R2">— ἐπανουργεῖτε ὡσ δη τῶν αἰγυπτίων<lb/>πανουργων ὄντων ÷</sch>
    <sch n="3" ancre="7" place="mg-d" main="R2">ἕωσ ζῶ</sch>
    <sch n="4" ancre="9" place="mg-g" main="R2">παροι<unclear cert="moyenne">μία</unclear> ἐπὶ τῶν <abbr signe="⌒" dev="ων">ἐπιχειρούντ</abbr> τι<lb/>πο<unclear cert="faible">ιεῖν</unclear> <unclear cert="moyenne"><abbr signe="ϗ" dev="καὶ"/></unclear> <unclear cert="faible">ἀ</unclear>ποτυγχανόντων ÷</sch>
    <sch n="5" ancre="9" place="mg-d" main="R2">ἡ σπάρ<abbr dev="ς">τ<hi rend="sus">ο</hi></abbr> <abbr dev="ὶ">αν<hi rend="sus">τ</hi></abbr> <abbr dev="οῦ">τ<hi rend="sus">υ</hi></abbr><lb/>ἡ μηχανή ÷</sch>
    <sch n="6" ancre="17" place="mg-g" main="R2">— ἐπεὶ ἀνω αιγυπτιάζειν αὐτουσ εφη<lb/>οἱ <abbr signe="ʒ" dev="δὲ"/> αιγυπτιοι λινοποιοι <abbr signe="·//·" dev="εἰσί"/> ÷</sch>
    <sch n="7" ancre="18" place="col" main="R2">ὁ πανοῦργοσ ἀπὸ μεταφορᾶσ τῶν τὰ ἄρμενα<lb/>ραπτοντων ÷</sch>
    <sch n="8" ancre="23" place="mg-g" main="R2">— <unclear cert="moyenne">προσ</unclear> σανισιν εδεσμευοντο πολ<lb coupe="oui"/>λακισ ὡσ <abbr signe="ϗ" dev="καὶ"/> κρατῖνοσ δηλοῖ· ἐπί<lb coupe="oui"/>τρεψον ο<unclear cert="moyenne">ὖ</unclear>ν τωι τοξότηι <abbr dev="σί">φ<hi rend="sus">η</hi></abbr> γυμνον<lb/>με δῆσαι προσ τῆι σανίδι ÷</sch>
    <sch n="9" ancre="25" place="mg-g" main="R2">αντι εστίασιν παρέχων αττικη <abbr signe="ʒ" dev="δὲ"/> ἡ <abbr dev="αξις">συν<hi rend="sus">τ</hi></abbr><lb/>οτι το εστιων <abbr signe="ϗ" dev="καὶ"/> δοτικη συντάσσουσιν<lb/>ὡσ <abbr signe="ϗ" dev="καὶ"/> παρ <abbr dev="ι">ευπολι<hi rend="sus">δ</hi></abbr> <abbr signe="·/·" dev="ἐστί"/> εν αυτολύκωι θα<lb coupe="oui"/>τέρωι ὡστε ου<abbr signe="ʒ" dev="δὲ"/> ἐκεῖ οὐδὲ ἐνθάδε δεῖ<lb/><abbr signe="ʒ" dev="αι">ξενίζεσθ</abbr> ÷</sch>
    <sch n="10" ancre="25" place="mg-d" main="R2">μετα κρο<hi rend="sus">κω</hi><abbr dev="οῦ">τ<hi rend="sus">υ</hi></abbr><lb/>τοῖσ κόραξιν<lb/>εστιασιν <abbr signe="⌒" dev="ων">παρεχ</abbr> ÷</sch>
    <sch n="11" ancre="28" place="mg-g" main="R2">τὸ παίξωμεν οἱ αττικοὶ <abbr signe="¯" dev="εν">παίσωμ</abbr> <abbr dev="ον">ἔλεγ</abbr><lb/><abbr signe="ϗ" dev="καὶ"/> τὸ παίσωμεν πάλιν παίξωμεν ÷</sch>
    <sch n="12" ancre="28" place="mg-d" main="R2">ὅτι <abbr dev="ς">ενδυσάμεν<hi rend="sus">ο</hi></abbr> <abbr signe="ϗ" dev="καὶ"/> ελθὼν εἰσ<lb/>τασ γυναῖκασ καταδηλοσ<lb/>εγενομην ÷</sch>
    <sch n="13" ancre="30" place="mg-d" main="R2">— <abbr signe="ϗ" dev="καὶ"/> πολυπαιγ<lb coupe="oui"/><abbr dev="ς">μον<hi rend="sus">ο</hi></abbr> ορχηθ<lb coupe="oui"/><signe type="autre" main="R2">/</signe>μοιο</sch>
    <sch n="14" ancre="31" place="mg-g" main="R2">— ὅταν τὰ μυστηρια αὔξωμεν <abbr dev="σί">φ<hi rend="sus">η</hi></abbr> τῶν <abbr signe="⌒" dev="ῶν">θε</abbr><lb/>λεγει <abbr signe="ʒ" dev="δὲ"/> δημητρασ <abbr signe="ϗ" dev="καὶ"/> περσεφόνησ —<lb/><abbr signe="~" dev="ως">ἄλλ</abbr> ὅταν τὰσ τελετὰσ αὔξωμεν τοιῖσ γὰρ<lb/><unclear cert="moyenne">ὑμνοισ</unclear> ἐπαίρομεν αὐτὰσ <abbr signe="ϗ" dev="καὶ"/> <abbr signe="˘" dev="οῦ">τ</abbr>το <abbr signe="·/·" dev="ἐστί"/> τ<unclear cert="moyenne">ὸ</unclear><lb/>ανεχομεν ÷</sch>
    <sch n="15" ancre="34" place="mg-d" main="R2">παύσων ὁ ζωγράφοσ εἰσ πε<lb coupe="oui"/>νίαν διαβάλλεται <abbr signe="ϗ" dev="καὶ"/> <abbr signe="ʒ" dev="ιὰ">δ</abbr><lb/>τοῦτο εἶπεν νηστεύει ÷</sch>
