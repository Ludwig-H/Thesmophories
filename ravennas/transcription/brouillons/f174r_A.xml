  <lignes>
    <l n="1" v="959" retrait="3">ἅμα δὲ καὶ</l>
    <l n="2" v="960" retrait="3">γένοσ ὀλυμπίων θεῶν</l>
    <l n="3" v="961" retrait="-3">μέλπε καὶ γέραιρε φωνῆι πᾶσα χορομανεῖ τρόπωι—</l>
    <l n="4" v="962" retrait="3">εἰ δέ τισ·</l>
    <l n="5" retrait="2">προσδοκᾶι κακῶσ ἐρεῖν·</l>
    <l n="6" retrait="2">ἐν ἱ ερῶ γυναῖ κα μ᾽ οὖσαν ἄνδρασ<signe type="repere" main="Rrec" instrument="mine">11</signe></l>
    <l n="7" retrait="2">οὐκ<unclear cert="moyenne">᾽</unclear> ὀρθῶσ φρονεῖ</l>
    <l n="8" retrait="2">ἀλλὰ χρὴ<unclear cert="faible">·</unclear></l>
    <l n="9" retrait="1">ὥ σπερ ἔρ γον αὖτί καιν<subst main="R?"><del type="surcharge">ὸ</del><add place="ligne">ό</add></subst>ν·</l>
    <l n="10" retrait="-4">πρῶ τον εὐ κύκλου χορείασ εὐφυῆ στῆσαι βάσιν·</l>
    <l n="11" retrait="1">πρ<unclear cert="moyenne">ό</unclear>βαινεπο σὶντὸν ἐλύραν·</l>
    <l n="12" retrait="1">μέλπουσα· καὶ τὴν τοξο φόρον</l>
    <l n="13" retrait="1">ἄρτεμιν ἄνασσαν ἁγν<subst main="R?"><del type="surcharge">ὴ</del><add place="ligne">ή</add></subst>ν·</l>
    <l n="14">χαῖρ᾽ ὦ ἑκάεργε· ὄπαζε δὲ νίκην·</l>
