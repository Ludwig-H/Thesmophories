    <sch n="1" ancre="6" place="mg-d" main="R2">ἴσωσ <abbr dev="όν">τ̀</abbr> ἥλιον ἀστέρα ἐκαλ<unclear cert="moyenne">έ</unclear>σεν ἢ <signe type="autre" main="R2">—</signe><lb/>μᾶλλον <abbr dev="όν">τ̀</abbr> <abbr dev="όν">κεραυν̀</abbr> ÷</sch>
