  <lignes>
    <l n="1" v="636">ἀπόδυσον αὐτὸν οὐδὲν ὑγιὲσ γὰρ λέγει·</l>
    <l n="2" v="637"><nota main="R2">μνη<hi rend="sus">σ</hi></nota>κἄπειτ ἀπο δύσετ ἐννέαπαί δων μητέρα·</l>
    <l n="3" v="638">χάλαι ταχέωσ τὸ στρόφιον ὦνἀίσχύντε σύ</l>
    <l n="4" v="639">ὡ σκαὶ στι βαρά τισ φαίνεται· καὶ καρτερά·</l>
    <l n="5" v="640">καὶ νὴ δί ατίτθοσγὥσπερ ἡ μεῖσ οὐκέχει·</l>
    <l n="6" v="641"><parag/>στεριφῆι γάρ ει μι κ᾽οὐκ᾽ἐκύησαπώποτε·</l>
    <l n="7" v="642">νῦν τό τεδη μήτηρ <unclear cert="moyenne">ῆ</unclear>σθαπαί δων ἐννέα·</l>
    <l n="8" v="643">ἀνί στασ ὀ ρ θόσ· ποῖ τὸ πέοσ ῶθεισ κάτω·</l>
    <l n="9" v="644"><parag/>τὸ δὶ δ<unclear cert="moyenne">ὴ</unclear> ἔκυψε καὶ μάλ᾽εὔχρων ὦ τάλαν·</l>
    <l n="10" v="645"><parag/><nota main="R2">κλεισ<hi rend="sus">θ</hi></nota>καὶ ποῦ<unclear cert="moyenne">᾽</unclear>στιν: αὖθι σ εἰστὸ πρόσθεν οἴχεται·</l>
    <l n="11" v="646"><parag/>οὐ κ<unclear cert="moyenne">έ</unclear>νγεταυθι; ἀλλὰ δεῦρ᾽ <ras main="R3">ἥκει πάλιν</ras>·<del type="grattage" main="R?"><gap n="3" unite="lettres" raison="grattage"/></del><signe type="renvoi" main="R?">÷</signe><add place="mg-d" main="R2"><signe type="renvoi" main="R?">÷</signe>ἰσ<hi rend="sus">θ</hi>μον τίν ἔχ<hi rend="sus"><unclear cert="moyenne">εισ</unclear></hi> ώνθρ<abbr signe="~" dev="ω"/>πε <abbr signe="~" dev="ω">ἄν</abbr> τ<hi rend="sus">ε</hi> <abbr signe="ϗ" dev="καί"/> <abbr signe="~" dev="ω">κάτ</abbr> <signe type="renvoi" main="R?">·/·</signe></add></l>
    <l n="12" v="648"><signe type="renvoi" main="R?">·/·</signe>τὸ πέο σδι ελκεισ πυκνό τερον κορινθίων·</l>
    <l n="13" v="649"><parag/><nota main="R2">γυ<hi rend="sus">ν</hi></nota>ὦ μιαρὸσ οὗτοσ· ταῦτ᾽ἄρ ὑπερ εὐριπίδου</l>
    <l n="14" v="650">ἡμῖ ν ἐλοι δορεῖτο:<nota main="R2">μνη<hi rend="sus">σ</hi></nota>κακοδαίμων ἐγ<subst main="R?"><del type="surcharge">ὼ</del><add place="ligne">ώ</add></subst>·</l>
    <l n="15" v="651">εἰ σ οἷ ἐμαυτὸν εἰ σεκύλη σα πράγματα·</l>
