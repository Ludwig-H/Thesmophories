    <sch n="27" ancre="43" place="mg-inf" main="R2">ἔγχυμον ἐποίησεν ἐν ἐνίοισ <abbr signe="ʒ" dev="δὲ"/> ἀχαιὸσ <abbr signe="ʒ" dev="αι">γέγραπτ</abbr> <abbr signe="ϗ" dev="καὶ"/> τὰ παλαιότερα ἀντίγραφα οὕτωσ <abbr dev="εν">εἶχ</abbr> ἀριστοφάνησ <abbr signe="ʒ" dev="δε"/> <abbr signe="·/·" dev="ἐστι"/> ὁ μεταγράψασ ἀλκαῖοσ<lb/><abbr dev="ρι">π<hi rend="sus">ε</hi></abbr> <abbr signe="Λ" dev="αρ">γ</abbr> παλαιων <abbr signe="·/·" dev="ἐστι"/> ὁ <abbr signe="°" dev="ος">λόγ</abbr> ὁ <abbr signe="ʒ" dev="δὲ"/> ἀχαιοσ <abbr signe="°" dev="ος">νεώτερ</abbr> το <abbr signe="ʒ" dev="δὲ"/> <abbr signe="⌒" dev="ον">λεγόμεν</abbr> ὑπο διδύμου προσ <abbr dev="άνην">ἀριστοφ<hi rend="sus">α</hi></abbr> ὅτι οὐ <abbr signe="ʒ" dev="αι">δύνατ</abbr> ἀλκαίου μνημονεύειν<lb/>οὐ <abbr signe="Λ" dev="αρ">γ</abbr> ἐπεπόλαζε <abbr dev="σι">φ<hi rend="sus">η</hi></abbr> τὰ ἀλκαίου διὰ τὴν <abbr dev="ον">διάλεκτ̀</abbr> <abbr signe="ʒ" dev="αι">λελήρητ</abbr> <abbr signe="ʒ" dev="δε"/> ἄντικρυσ <abbr signe="ϗ" dev="καὶ"/> ἐν τῶ προ τούτου δράματι τοῖσ ὄρνισι παρώ<lb coupe="oui"/><abbr signe="ʒ" dev="αι">δητ</abbr> τὸ ὄρνιθεσ τινεσ <abbr signe="ʒ" dev="δε"/> ωκεανω τα σα πτερα τουθ᾽ ωσ ὄρνιθέσ τινεσ οἳ οὐδὲν ἔχον <abbr signe="ϗ" dev="και"/> ἐν <abbr dev="ιν">σφηξ</abbr> ὠνὴρ οὗτοσ ὁ <abbr signe="⌒" dev="ος">μαιόμεν</abbr> τὸ μέγα<lb/><abbr signe="°" dev="ος">κρατ</abbr> ἀλλαχοῦ <abbr signe="ʒ" dev="δὲ"/> ὁ <abbr signe="°" dev="ος">δίδυμ</abbr> <abbr dev="σι">φ<hi rend="sus">η</hi></abbr> ἡ μεν γραφὴ <abbr signe="ʒ" dev="αι">δύνατ</abbr> με<abbr signe="⌒" dev="ν"/> εἶναι οὐκ αν <abbr signe="ʒ" dev="δὲ"/> <abbr signe="˘" dev="ου">τ</abbr><abbr signe="˘" dev="ου">τ</abbr> του μελοποιου <abbr signe="ʒ" dev="αι">μέμνητ</abbr> παλιν το αυτὸ λέγων<lb/>ὅτι οὐκ ἐπεπόλαζε τα μέλη ἀλκαίου του κιθαρωδοῦ οὗ <abbr signe="ϗ" dev="καὶ"/> <abbr dev="ις">εὔπο<hi rend="sus">λ</hi></abbr> ἐν χρυσῶ γένει <abbr signe="ʒ" dev="αι">μέμνητ</abbr> ὠλκαῖε σικελιῶτα πελοπο<lb coupe="oui"/>νήσιε τι <abbr signe="ʒ" dev="δὲ"/> ἐνταῦθα κιθαρωδοῦ περι <abbr signe="˘" dev="ου">ποιητ</abbr> <abbr signe="°" dev="ος">ὄντ</abbr> <abbr signe="˘" dev="οῦ">τ</abbr> λόγου ÷</sch>
