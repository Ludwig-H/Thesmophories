    <sch n="4" ancre="10" place="mg-d" main="R2">— πᾶν εφ ὧ<unclear cert="faible">ι</unclear><lb/>τισ <unclear cert="moyenne">αν</unclear> <unclear cert="faible">λ</unclear>ε<unclear cert="moyenne">γη</unclear><abbr signe="ʒ" dev="αι">τ</abbr><lb/>πινακια <abbr signe="ʒ" dev="δὲ"/> ησαν<lb/>ανακείμενα ÷</sch>
    <sch n="5" ancre="11" place="mg-g" main="R2">πινακεσ ο<signe type="autre">ʌ</signe> ἦσαν εν τῶ ϊερῶ <abbr signe="ϗ" dev="καὶ"/> ἀπο<lb/><abbr signe="˘" dev="ού">τ</abbr>τω<unclear cert="faible">ν</unclear> λαβων γράφει <abbr signe="ϗ̀" dev="καὶ"/> ρίπτει αυτὰσ<lb/>λεγω<gap n="2" unite="lettres" raison="illisible"/>ξελθέτε σημάνατε <abbr dev="ίδῃ">ευρι<hi rend="sus">π</hi></abbr> ÷</sch>
    <sch n="6" ancre="14" place="mg-d" main="R2">· ἄνυσιν ἔχοντι<lb/><abbr signe="ϗ" dev="καὶ"/> επινοιαν ÷</sch>
    <sch n="7" ancre="16" place="mg-g" main="R2">— ὁλκο<unclear cert="moyenne">ὺσ</unclear> λεγει τὰ σημεὶα επειδὴ <abbr signe="¯" dev="ενα">ἑλκόμ</abbr> γρά<lb coupe="oui"/><abbr signe="ʒ" dev="αι">φον<unclear cert="moyenne">τ</unclear></abbr> ÷</sch>
    <sch n="8" ancre="16" place="mg-d" main="R2"><unclear cert="moyenne">σ</unclear>μιλῆσ λέγει <abbr dev="ὶ">αν<hi rend="sus">τ</hi></abbr><lb/><abbr signe="¯" dev="οῦ">τ</abbr> γραφείου ÷</sch>
    <sch n="9" ancre="18" place="mg-g" main="R2">— ἐν τ<unclear cert="moyenne">ῶ</unclear> γράφειν τ<unclear cert="moyenne">ὸ</unclear> <abbr signe="˘" dev="οῦ">τ</abbr> <abbr dev="ίδου">ευρι<hi rend="sus">π</hi></abbr> όνομα <abbr signe="˘" dev="οῦ">τ</abbr>το <abbr dev="σί">φ<hi rend="sus">η</hi></abbr> ÷</sch>
    <sch n="10" ancre="18" place="mg-d" main="R2">ὡσ <abbr dev="ίδης">ευρι<hi rend="sus">π</hi></abbr> γράφων ἐν ὧ το ρ̄ <abbr signe="·/·" dev="ἐστί"/> ÷</sch>
