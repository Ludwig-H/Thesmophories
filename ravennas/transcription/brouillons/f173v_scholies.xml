<!-- Scholies et gloses marginales de R, f. 173v (vv. 920–958) : LECTURE EN COURS (lettres lues ; diacritiques en cours de contrôle). -->
<page folio="f173v" image="23_f173v_classense175v_vv0920-0958.jpg" vers="920-958">
  <lignes/>
  <scholies>
    <sch n="1" ancre="2" place="mg-d" main="R2">οὐ κυρίωσ <abbr signe="\" dev="ον">ἄλλοι</abbr><lb/>κενοβουλοσ ÷</sch>
    <sch n="2" ancre="3" place="mg-g" main="R2">— ἐπανουργεῖτε ὡσ δη τῶν αἰγυπτίων<lb/>πανουργων ὄντων ÷</sch>
    <sch n="3" ancre="7" place="mg-d" main="R2">ἕωσ ζῶ</sch>
    <sch n="4" ancre="9" place="mg-g" main="R2">παροιμία ἐπὶ τῶν <abbr signe="⌒" dev="ων">ἐπιχειρούντ</abbr> τι<lb/>πο<unclear cert="faible">ιεῖν</unclear> <unclear cert="moyenne"><abbr signe="ϗ" dev="καὶ"/></unclear> <unclear cert="faible">α</unclear>ποτυγχανόντων ÷</sch>
    <sch n="5" ancre="9" place="mg-d" main="R2">ἡ σπάρτ(οσ) ἀν(τὶ) τ(οῦ)<lb/>ἡ μηχανή ÷</sch>
    <sch n="6" ancre="17" place="mg-g" main="R2">— ἐπεὶ ἄνω αιγυπτιάζειν αυτουσ εφη<lb/>οι <abbr signe="ʒ" dev="δὲ"/> αιγυπτιοι λινοποιοι <abbr signe="·//·" dev="εἰσί"/> ÷</sch>
    <sch n="7" ancre="18" place="col" main="R2">ὁ πανοῦργοσ ἀπὸ μεταφορᾶσ τῶν τὰ ἄρμενα<lb/>ραπτόντων ÷</sch>
    <sch n="8" ancre="23" place="mg-g" main="R2">— προσ σανίσιν ἐδεσμεύοντο πολ<lb coupe="oui"/>λάκισ ὡσ <abbr signe="ϗ" dev="καὶ"/> κρατῖνοσ δηλοῖ· ἐπί<lb coupe="oui"/>τρεψον οὖν τωι τοξότηι <abbr dev="σι">φ<hi rend="sus">η</hi></abbr> γυμνόν<lb/>με δῆσαι προσ τῆι σανίδι ÷</sch>
    <sch n="9" ancre="25" place="mg-g" main="R2">αντι εστίασιν παρέχων αττικη <abbr signe="ʒ" dev="δὲ"/> ἡ <abbr dev="αξισ">συν<hi rend="sus">τ</hi></abbr><lb/>ὅτι το εστιων <abbr signe="ϗ" dev="καὶ"/> δοτικη συντάσσουσιν<lb/>ὡσ <abbr signe="ϗ" dev="καὶ"/> παρευπολ<abbr dev="ίδι">ι</abbr> <abbr signe="·/·" dev="ἐστι"/> εν αυτολύκωι θα<lb coupe="oui"/>τέρωι ὥστε ου<abbr signe="ʒ" dev="δὲ"/> ἐκεῖ οὐδὲ ἐνθάδε δεῖ<lb/>ξενίζεσθ<abbr signe="ʒ" dev="αι"/> ÷</sch>
    <sch n="10" ancre="25" place="mg-d" main="R2">— μετὰ κρο<hi rend="sus">κω</hi><abbr dev="οῦ">τ<hi rend="sus">υ</hi></abbr><lb/>τοῖσ κόραξιν<lb/>εστίασιν <abbr signe="⌒" dev="ων">παρεχ</abbr> ÷</sch>
    <sch n="11" ancre="28" place="mg-g" main="R2">τὸ παίξωμεν οἱ ἀττικοὶ παίσωμ<abbr signe="¯" dev="εν"/> ἔλεγ<lb/><abbr signe="ϗ" dev="καὶ"/> τὸ παίσωμεν πάλιν παίξωμεν ÷</sch>
    <sch n="12" ancre="28" place="mg-d" main="R2">ὅτι ἐνδυσάμεν<abbr signe="°" dev="ος"/> <abbr signe="ϗ" dev="καὶ"/> ελθὼν εἰσ<lb/>τασ γυναῖκασ καταδηλοσ<lb/>ἐγενόμην ÷</sch>
    <sch n="13" ancre="30" place="mg-d" main="R2">— <abbr signe="ϗ" dev="καὶ"/> πολυπαίγ<lb coupe="oui"/><abbr dev="ος">μον<hi rend="sus">ο</hi></abbr> ὀρχηθ<lb coupe="oui"/>μοιο</sch>
    <sch n="14" ancre="32" place="mg-g" main="R2">ὅταν τὰ μυστήρια αὔξωμεν <abbr dev="σι">φ<hi rend="sus">η</hi></abbr> τῶν <abbr signe="⌒" dev="ῶν">θε</abbr><lb/>λέγει <abbr signe="ʒ" dev="δὲ"/> δημήτρασ <abbr signe="ϗ" dev="καὶ"/> περσεφόνησ —<lb/><abbr signe="~" dev="ως">ἄλλ</abbr> ὅταν τὰσ τελετὰσ αὔξωμεν τοιῖσ γὰρ<lb/>ὕμνοισ ἐπαίρομεν αὐτὰσ <abbr signe="ϗ" dev="καὶ"/> <abbr signe="˘" dev="οῦ">τ</abbr>το <abbr signe="·/·" dev="ἐστι"/> τὸ<lb/>ἀνέχομεν ÷</sch>
    <sch n="15" ancre="34" place="mg-d" main="R2">παύσων ὁ ζωγράφοσ εἰσ πε<lb coupe="oui"/>νίαν διαβάλλεται <abbr signe="ϗ" dev="καὶ"/> <abbr signe="ʒ" dev="ιὰ">δ</abbr><lb/>τοῦτο εἶπεν νηστεύει ÷</sch>
  </scholies>
  <notes>
    <note>Brouillon en cours de contrôle.</note>
  </notes>
</page>
