  <lignes>
    <l n="1" v="835">ἔντε ταῖσ ἄλλαισ ἑορταῖσ α<subst main="R2"><del type="grattage"><unclear cert="moyenne">ῖ</unclear></del><add place="ligne">ἷ</add></subst>σιν ἡμεῖσ ἤγομεν·</l>
    <l n="2" v="836"><unclear cert="moyenne">ἦ</unclear>ν δε δειλὸν καὶ πονηρὸν ἄνδρα τίσ τεκοι γυνὴ·</l>
    <l n="3" v="837">ἢ τριήραρχον πονηρὸν· ἢ κυβερνήτην κακόν·<signe type="repere" main="Rrec" instrument="mine">—</signe><signe type="repere" main="R?"><unclear cert="faible">6</unclear></signe></l>
    <l n="4" v="838"><subst main="R?"><del type="grattage">ὕ</del><add place="ligne">ὑ</add></subst>στέραν αὐτὴν καθῆσθαι σκάφιον <abbr signe="Λ" dev="ην">ἀποκεκαρμέν</abbr></l>
    <l n="5" v="839">τῆ στὸν ἀνδρεῖον τεκούσησ· τῶι γὰρ εἰκὸσ ὦ πόλεισ·</l>
    <l n="6" v="840">τὴν ὑπερβόλου καθῆ σθαι μητέρ᾽ ἠμφιεσμένην·</l>
    <l n="7" v="841">λευκὰκαὶ κόμασ καθεῖ σαν πλησίον τῆσ λαμάχου·</l>
    <l n="8" v="842">καὶ δανείζειν χρήματα τ<unclear cert="faible">ῆ</unclear> νχρῆν <unclear cert="moyenne">ἦ</unclear>ν δανείσειέ τινι·</l>
    <l n="9" v="843">καὶ τόκονπράττοι το διδόναι μηδέν᾽ <abbr signe="¯" dev="ἀνθρώπων"/> τόκον·</l>
    <l n="10" v="844">ἀλλ᾽ ἀφ ερεῖσθαι βία<unclear cert="moyenne">ί</unclear> τὰ χρή ματατ᾽ εἰπόντασ τ<subst main="R?"><del type="exponctuation">ὰ</del><add place="dessus">ο</add></subst>δὶ</l>
    <l n="11" v="845"><subst main="R?"><del type="grattage"><unclear cert="moyenne">ἄ</unclear></del><add place="ligne">ἀ</add></subst>ξία γοῦν <unclear cert="moyenne">εἰ</unclear> τόκου τεκου<add place="dessus" main="R?">σα</add> τοιοῦτον τόκον·</l>
    <l n="12" v="846"><nota main="R2" repasse="Rrec">μνη<hi rend="sus">σ</hi></nota>ἰλλὸσ γεγένημαι, προσδοκῶν· ὁ δ᾽ οὐδέπω·</l>
    <l n="13" v="847">τί δῆτ᾽ ὰν είη τοὐμποδ<unclear cert="moyenne">ὼ</unclear>ν οὐκέσθ᾽ ὅπωσ</l>
    <l n="14" v="848">οὐτὸνπαλαμή δη ψυχρὸν ὄντ᾽ αἰσχύνεται·</l>
    <l n="15" v="849">τῶι δῆτ᾽ ἂν<signe type="autre" main="R?">˘</signe> αὐτὸν προ σαγαγοίμην δράματι·</l>
    <l n="16" v="850">ἐγῶ<unclear cert="moyenne">ι</unclear>δα τὴν καινὴν ἑλένην μιμήσομαι·</l>
    <l n="17" v="851">πάντωσ ὑπάρχει μοι γυναικεία στολή·</l>
    <l n="18" v="852"><parag/><nota main="R2" repasse="Rrec">γυ<hi rend="sus">ν</hi></nota>τί αὖ σὺ κυρκανᾶισ· ἤ τί κοικύλλεισ ἔχων·</l>
