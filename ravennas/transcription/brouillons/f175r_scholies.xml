    <sch n="6" ancre="12" place="mg-d" main="R2">— ὑποκρίνεται <abbr dev="ίδης">εὐρι<hi rend="sus">π</hi></abbr> το πρόσωπον <abbr signe="¯" dev="ῆς">τ</abbr> ἠχοῦσ ÷</sch>
