<!-- Lecture A (lecture directe) de R, f. 169r ; en cours -->
<page folio="169r" image="14_f169r_classense171r_vv0551-0589.jpg" vers="551-592">
  <lignes>
    <l n="1" v="551"><nota main="Rrec">γυνη</nota>ἀκούετ᾽ ὦ γυναῖ κεσ οἷ᾽ εἴρηκεν ἡ πανοῦργοσ·</l>
    <l n="2" v="552">ἡ μᾶσ ἁπάσασ αὖθισ: αὖ<signe type="insertion" main="Rrec">+</signe><signe type="insertion" main="Rrec">ʌ</signe><nota main="Rrec">κη<hi rend="sus">δ</hi></nota>καὶ νὴ δί᾽ οὐδέπω γε·</l>
    <l n="3" v="553">εἴ ρηχ᾽ ὅ σαξυνοιδ᾽ ἐπεὶ βούλεσθε μᾶλλον εἴπω·</l>
    <l n="4" v="554"><parag/><nota main="Rrec">γυνη</nota>ἀλλ᾽ οὐκ᾽ ἂν <unclear cert="moyenne">ἔ</unclear>χοισ· ὅ σαγὰρ ἤι δεισ ἐξέχεασ <unclear cert="moyenne">ἅ</unclear>παντ<hi rend="sus">α</hi>·</l>
    <l n="5" v="555"><parag/><nota main="Rrec">κη<hi rend="sus">δ</hi></nota>μὰ δί᾽ οὐ δετὴ ν μυριοστὴν μοῖραν ὧν ποι οῦμεν</l>
    <l n="6" v="556">ἔπει τόγ᾽ οὐχ εἴρηχ᾽ ὁρᾶισ ὡ στλεγγίδασ λαβοῦσαι·</l>
    <l n="7" v="557">ἐπεὶ<add place="dessus" main="R2">τα</add> σιφω νίζομεν τὸν σῖτον:<nota main="Rrec">γυ<hi rend="sus">η</hi></nota>· ἐπιτριβεί ησ·</l>
    <l n="8" v="558"><nota main="Rrec">κη<hi rend="sus">δ</hi></nota>ὡστ αὖτὰ κρέ᾽ ἐξ ἀπατουρίωνταῖσμαστροποῖσ<abbr signe="~" dev="αι">διδοῦσ</abbr></l>
    <l n="9" v="559">ἔπει τατὴν γαλ<unclear cert="moyenne">ὴ</unclear>ν φαμέν:<nota main="Rrec">γυ<hi rend="sus">η</hi></nota> τάλαιν᾽ ἐγὼ φλυαρεῖσ·</l>
    <l n="10" v="560"><unclear cert="faible"><parag/></unclear><nota main="Rrec">κη<hi rend="sus">δ</hi></nota><hi rend="grand">ο</hi>ὐδ᾽ ὡστὸν ἄνδρα τῶι πελεκει γυνὴ κατεσπόδησεν</l>
    <l n="11" v="561">οὐκεἶπον· οὐδ᾽ ὡσφαρμάκοισ ἑτέρα τὸν ἄνδρ᾽ ἔμ<unclear cert="faible">ηνε</unclear>ν</l>
    <l n="12" v="562">οὐδ᾽ ὡσ ὑπὸ τῆι πυέλωι κατώρυξένποτε· ἐξόλοιο·</l>
    <l n="13" v="563">ἀ<unclear cert="moyenne">γ</unclear>χαρνικὴ τὸν <abbr signe="¯" dev="πατέρα"/>· ταυτὶ δῆτ᾽ ἀνέκτ᾽ ἀκούειν·</l>
    <l n="14" v="564">οὐδ᾽ ὡσσὺ τῆσ δούλησ τεκούσησ ἄρρεν· εἶτα σαυτῆι</l>
    <l n="15" v="565">τοῦθ᾽ ὑπεβάλου· τὸ σὸν δε θυγάτριον παρῆκασ αὐτῆι</l>
    <l n="16" v="566"><unclear cert="faible"><parag/></unclear><nota main="Rrec">γυ<hi rend="sus">η</hi></nota><hi rend="grand">ο</hi>ὔτοι μὰ τὼ θεὼ<signe type="renvoi" main="R2">·×·</signe> σὺ καταπροίξει λέγουσα ταυτὶ</l>
    <l n="17" v="567">ἀλλ᾽ ἐκποκιῶ σουτὰσ ποκάδασ:</l>
    <l n="18"><signe type="autre" main="Rrec">/</signe>οὐ δεμὰ δία σύ γ᾽ ἅψει·</l>
    <l n="19" v="568">καὶ μὴν <unclear cert="moyenne">ϊ</unclear>δοὺ· καὶ μὴν ἰδού: λάβεθοιμάτιον φιλ<subst main="R?"><del type="grattage">η</del><add place="ligne">ί</add></subst>στη·</l>
